{
  "name": "reed",
  "version": "0.3.0",
  "private": true,
  "description": "Reed 一苇 — 一苇以航，轻渡学海。独立 Windows 学习 Agent。",
  "scripts": {
    "test": "node --test --test-isolation=none desktop/agent/*.test.mjs",
    "agent:install": "npm ci --prefix desktop/agent",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/tools/package-portable.ps1",
    "test:desktop": "node desktop/tools/desktop-acceptance.cjs",
    "test:splash": "node desktop/tools/splash-check.cjs",
    "test:window": "node desktop/tools/window-state-acceptance.cjs",
    "build:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/tools/package-installer.ps1",
    "sign:release": "pwsh -NoProfile -ExecutionPolicy Bypass -File desktop/tools/package-release.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1"
  },
  "dependencies": {
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3"
  }
}
